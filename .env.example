# Create an app password in Yandex ID; NEVER commit the real .env
YANDEX_EMAIL=your-address@yandex.com
YANDEX_APP_PASSWORD=replace-me
YANDEX_IMAP_HOST=imap.yandex.com
YANDEX_IMAP_PORT=993

# Mutating IMAP tools are disabled unless explicitly enabled.
YANDEX_ALLOW_WRITE=false
YANDEX_PROMOTIONS_FOLDER=AI-Promotions

# MCP: stdio is default; see README's HTTP setup for authentication and proxy guidance.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Required for non-loopback HTTP unless explicitly overridden; use HTTPS behind a proxy.
MCP_AUTH_TOKEN=
MCP_ALLOW_UNAUTHENTICATED_REMOTE=false
# Set these for the actual public host/origin when binding a wildcard address.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,mail.example.com:*
# MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://mail.example.com:*
