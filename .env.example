# NEVER commit the real .env
# Your Yandex OAuth application (see README); then run `yandex-mail-mcp login`.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# Port of the loopback redirect URI http://127.0.0.1:<port>/callback used by `login`.
YANDEX_OAUTH_LOOPBACK_PORT=8765
# Alternatives to `login`: a ready access token with the address it belongs to,
# or (deprecated) a Yandex Mail app password.
# YANDEX_EMAIL=your-address@yandex.com
# YANDEX_OAUTH_TOKEN=
# YANDEX_APP_PASSWORD=
YANDEX_IMAP_HOST=imap.yandex.com
YANDEX_IMAP_PORT=993
# Logged-in IMAP connections reused across tool calls, and seconds an idle one is kept.
YANDEX_IMAP_POOL_SIZE=2
YANDEX_IMAP_IDLE_TIMEOUT=300

# Mutating IMAP tools are disabled unless explicitly enabled.
YANDEX_ALLOW_WRITE=false
YANDEX_PROMOTIONS_FOLDER=AI-Promotions
# archive_email uses this folder, or the one the server flags \Archive when empty.
YANDEX_ARCHIVE_FOLDER=
# Set to false to change the Seen and Flagged flags and save drafts without a confirmation request.
MCP_CONFIRM_REVERSIBLE=true

# MCP: stdio is default; see README's HTTP setup for authentication and proxy guidance.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Required for non-loopback HTTP unless explicitly overridden; use HTTPS behind a proxy.
MCP_AUTH_TOKEN=
MCP_ALLOW_UNAUTHENTICATED_REMOTE=false
# Set these for the actual public host/origin when binding a wildcard address.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,mail.example.com:*
# MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://mail.example.com:*
