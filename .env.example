# NEVER commit the real .env.
# The server and the login/logout commands read .env from the project checkout and
# never override variables already set in the environment. README.md, "Configuration",
# lists every variable.

# Your Yandex OAuth application (see README).
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# Offer the tools that change mail; users must also grant full IMAP access.
YANDEX_ALLOW_WRITE=false

# --- One user, stdio: run `yandex-mail-mcp login` once. ---
# Port of the loopback redirect URI http://127.0.0.1:<port>/callback used by `login`.
YANDEX_OAUTH_LOOPBACK_PORT=8765
# Instead of `login` (for CI and containers): a ready access token and its address.
# YANDEX_EMAIL=your-address@yandex.ru
# YANDEX_OAUTH_TOKEN=

# --- Shared HTTP server (docker compose): users sign in with Yandex. ---
# The HTTPS URL clients use; register <url>/oauth/yandex/callback at Yandex.
MCP_PUBLIC_URL=https://mail.example.com
# Generate with:
# python -c "import secrets, base64; print('k1:' + base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# To rotate, put the new key first and keep the old one for 30 days: k2:...,k1:...
MCP_TOKEN_ENCRYPTION_KEYS=
# Comma-separated Yandex logins or addresses allowed to sign in; empty refuses everyone.
MCP_ALLOWED_USERS=
# Requests per client IP and minute to the sign-in and token endpoints.
MCP_AUTH_RATE_LIMIT=30

# IMAP
YANDEX_IMAP_HOST=imap.yandex.com
YANDEX_IMAP_PORT=993
# Logged-in IMAP connections per user, reused across tool calls (Yandex limits concurrent
# sessions per account), and seconds an idle one is kept before it is replaced.
YANDEX_IMAP_POOL_SIZE=2
YANDEX_IMAP_IDLE_TIMEOUT=300

# Changing tools
YANDEX_PROMOTIONS_FOLDER=AI-Promotions
# archive_email uses this folder, or the one the server flags \Archive when empty.
YANDEX_ARCHIVE_FOLDER=
# Set to false to change the Seen and Flagged flags and save drafts without a
# confirmation request. Moves and archiving are always confirmed.
MCP_CONFIRM_REVERSIBLE=true

# Set these for the actual public host/origin when the defaults do not fit.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,mail.example.com
# MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://mail.example.com
